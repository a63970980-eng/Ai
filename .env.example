APP_NAME=AI Forex Trading Robot
ENVIRONMENT=development
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=3
MAX_SPREAD_PIPS=2.0
MAX_SLIPPAGE_PIPS=1.0
MIN_SIGNAL_CONFIDENCE=0.65

# AI council: comma-separated provider:model entries; leave blank for built-in registry.
AI_COUNCIL_MODELS=
AI_LEDGER_DB=data/ai_ledger.sqlite3
AI_JOURNAL_DB=data/trades.sqlite3

# AI providers used by the multi-model council.
# Put real secrets in GitHub Actions Secrets / Vercel Environment Variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-32b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional local OpenAI-compatible AI server (Ollama/vLLM).
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=qwen3:8b

# Preferred independent real-market-data feed for safe paper trading.
# This does not place broker orders and does not require a broker account.
TWELVE_DATA_API_KEY=

# Optional read-only OANDA market feed. Twelve Data is preferred when configured.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Optional broker credentials; live execution remains disabled by default.
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Docker/PostgreSQL local development only
POSTGRES_USER=forex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forex
DATABASE_URL=postgresql://forex:change-me@localhost:5432/forex
