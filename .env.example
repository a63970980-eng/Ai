APP_NAME=AI Forex Trading Robot
ENVIRONMENT=development
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=3
MAX_SPREAD_PIPS=2.0
MAX_SLIPPAGE_PIPS=1.0
MIN_SIGNAL_CONFIDENCE=0.65

# AI providers. Keep real values in Vercel/secret manager, never Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional read-only market feed. Paper execution remains separate and live trading is disabled by default.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Optional broker credentials; live execution remains disabled by default.
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Docker/PostgreSQL local development only
POSTGRES_USER=forex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forex
DATABASE_URL=postgresql://forex:change-me@localhost:5432/forex
