APP_NAME=AI Crypto Quant Trading Robot
ENVIRONMENT=development

# OKX V5 Demo Trading — NEVER commit real credentials
OKX_DEMO=true
OKX_REST_URL=https://openapi.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Hard safety defaults
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=3
MAX_SPREAD_FRACTION=0.0015
MAX_SLIPPAGE_FRACTION=0.001
MIN_SIGNAL_CONFIDENCE=0.65

# Legacy API compatibility during migration
MAX_SPREAD_PIPS=20000
MAX_SLIPPAGE_PIPS=10000

# AI council
AI_COUNCIL_MODELS=
AI_LEDGER_DB=data/ai_ledger.sqlite3
AI_JOURNAL_DB=data/trades.sqlite3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-32b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=qwen3:8b
